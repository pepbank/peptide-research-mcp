  "description": "Studies and clinical trials for BPC-157, retatrutide, tirzepatide and 160+ peptides, with sources.",
  "version": "1.5.4",
  "websiteUrl": "https://pepbank.io/developers",
  "repository": {
    "url": "https://github.com/pepbank/peptide-research-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://pepbank.io/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://pepbank.io/icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "pepbank",
      "version": "1.0.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://pepbank.io/mcp"
    }
